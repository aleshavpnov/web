{
	"name": "web",
	"type": "module",
	"version": "4.2.0",
	"private": true,
	"license": "MIT",
	"description": "Alesha Vpnov web front: public site and the user cabinet Mini App.",
	"engines": {
		"node": "26.11.1"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"check": "astro check && svelte-check",
		"test": "node --test 'src/**/*.test.ts'",
		"test:e2e": "playwright test",
		"astro": "astro",
		"format": "oxlint --fix --disable-nested-config && prettier --write .",
		"format:check": "prettier --check .",
		"lint:css": "stylelint \"src/**/*.{css,astro,svelte}\"",
		"lint:js": "oxlint --deny-warnings --disable-nested-config",
		"lint:fix": "oxlint --fix --disable-nested-config",
		"prepare": "husky",
		"commit": "cz"
	},
	"dependencies": {
		"@astrojs/sitemap": "3.7.4",
		"@astrojs/svelte": "9.0.1",
		"astro": "7.3.7",
		"qrcode": "1.5.4",
		"svelte": "5.57.2"
	},
	"devDependencies": {
		"@aimuzov/infra-site-kit": "github:aimuzov/infra-site-kit#v5.9.0",
		"@astrojs/check": "0.9.10",
		"@commitlint/cli": "21.0.2",
		"@commitlint/config-conventional": "21.0.2",
		"@csstools/postcss-global-data": "4.0.0",
		"@fontsource-variable/manrope": "5.3.0",
		"@lucide/svelte": "1.55.0",
		"@playwright/test": "1.64.0",
		"@types/node": "26.6.5",
		"@types/qrcode": "1.5.6",
		"commitizen": "4.3.2",
		"cz-git": "1.13.1",
		"husky": "9.1.7",
		"oxlint": "1.87.0",
		"postcss-custom-media": "12.0.3",
		"postcss-nested": "8.0.1",
		"prettier": "3.9.9",
		"stylelint": "17.16.0",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3",
		"zod": "3.25.76"
	},
	"imports": {
		"#frontend/*": "./src/frontend/*",
		"#shared/*": "./src/shared/*"
	},
	"config": {
		"commitizen": {
			"path": "node_modules/cz-git"
		}
	}
}
