---
import '@fontsource-variable/manrope'
import '@aimuzov/infra-site-kit/base.css'
import '@aimuzov/infra-site-kit/ui/tokens.css'
import ThemeBoot from '@aimuzov/infra-site-kit/theme-boot.astro'

import { THEME_KEY } from '#frontend/lib/theme.ts'
import '#frontend/styles/global.css'

type Props = {
	/** Блок вместо колонки сайта: у кабинета своя разметка экрана. */
	bare?: boolean
}

// Голая разметка обезличена: нейтральный title, ни бренда, ни описания. Сканер без JS
// видит пустой "Личный кабинет", а брендовый текст рисуют острова `client:only`.
const { bare = false } = Astro.props
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#0c0a09" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Личный кабинет</title>
		<ThemeBoot key={THEME_KEY} />
		<slot name="head" />
	</head>
	<body>
		{bare ? (
			<slot />
		) : (
			<div class="column">
				<slot />
			</div>
		)}
	</body>
</html>
